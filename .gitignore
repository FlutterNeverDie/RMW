# 열쇠 - 절대 올리지 않음
secrets/
*.key
# 설치물·캐시 (새 맥에서 setup.sh가 다시 만든다)
node_modules/
.venv/
audio/sf/
audio/.tts-cache/
audio/.cast-raw/
audio/.ep-raw/
audio/.bgm/
# 렌더 결과·큰 중간물 (산출물은 ~/hwm에, 목소리는 다시 만들 수 있음)
out/
public/ep/
public/demo/
public/desk/
public/shots/
.DS_Store
# 편집기 저장 직전 장면표 (편집기 "내역"에서 보고 되돌림, 이 컴퓨터에만)
episodes/*/.history/
audio/.gemini-usage.json
__pycache__/
# 로컬 AI 모델 (setup.sh가 받음)
models/
# 지도 장면 지형 원본 자료(Natural Earth·ETOPO, 퍼블릭 도메인 - 크다, scripts/terrain.mjs가 받음)와 가공물
data/geo/
# 브금 wav는 audio/make_bgm.py로 다시 만든다 (14곡 약 200MB, setup.sh가 렌더)
public/bgm/*.wav
# 옛 그림 깊이 지도 캐시 (scripts/parallax.py)
audio/.depth/
# 효과음 원본 녹음(Kenney·OpenGameArt·NPS·Wikimedia Commons - CC0·퍼블릭 도메인·CC BY, 크다, setup.sh가 받음). 가공본은 public/sfx/ep
audio/sfx-src/
# 시네마틱 지형 캐시 (blender/prep_terrain.py가 만듦 - data/geo/ 아래라 위 줄로 이미 빠짐: terrarium 조각·굽기 결과)
data/geo/terrarium/
data/geo/cinematic/
# 시네마틱 근경 고도(Copernicus GLO-30 조각)·하늘 HDRI(Poly Haven CC0 원본) - blender/prep_terrain.py·prep_sky.py가 받음
data/geo/copdem30/
data/geo/hdri/
