{
 "_설명": "한국어 대사 규칙 (ko.md를 기계가 잡을 수 있게). scripts/check-text.py가 씀, 편집기에 오류로 뜸. 형식은 scripts/langrules.py 머리말. 고치면 python3 scripts/check-text.py --selftest",
 "lang": "ko",
 "registers": {
  "_설명": "문장 끝 말투 분류 - 인물 대사는 한 인물이 한 말투를 지키는지(장면 사이) 봄. 내레이션은 해요체 (02 결정)",
  "narration": "해요",
  "speaker_level": "warn",
  "classes": {
   "합쇼": {"pattern": "{ㅂ받침}니[다까]|십시오", "position": "sentence_end", "examples": ["초원에 섰습니다.", "어디로 갑니까?"]},
   "하오": {"pattern": "(?:하오|이오|소|구려|시오|거요)", "position": "sentence_end", "examples": ["내 말을 들으시오!", "그대가 옳소.", "피는 흘리지 않을 거요."]},
   "해요": {"pattern": "[요죠]", "position": "sentence_end", "examples": ["초원에 섰어요.", "그렇죠?"]},
   "반말": {"pattern": "(?:다|냐|니|라|자|어|아|야|지|군|구나|네|거든)", "position": "sentence_end", "examples": ["우리가 이긴다!", "어디로 가냐?", "가자!", "내가 왕이야."]}
  }
 },
 "rules": [
  {
