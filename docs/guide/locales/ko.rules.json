   "msg": "내레이션 합쇼체 명령(~십시오) → ~세요",
   "bad": ["지도를 보십시오."], "good": ["지도를 보세요."],
   "fixes": [["지도를 보십시오.", "지도를 보세요."]]
  },
  {
   "id": "ko-geosida", "group": "말투", "kind": "style", "level": "error", "scope": "narration", "position": "anywhere",
